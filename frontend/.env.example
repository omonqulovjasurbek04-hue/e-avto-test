# Development values. A production build (npm run build) refuses localhost/http API URLs and VITE_USE_MOCK=true;
# pass the real one:  VITE_API_URL=https://api.example.uz/api npm run build
VITE_API_URL=http://localhost:5000/api
VITE_USE_MOCK=false
# Telegram link for visitor questions (FAQ section on the home page). Leave empty to hide the button.
VITE_TELEGRAM_URL=
