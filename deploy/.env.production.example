# Copy to deploy/.env.production (never commit it) and replace every value.
# On the server it is created by server-setup.sh; keep it chmod 600.

# Where CI pushes the images (GitHub Container Registry of the repository owner, lowercase).
IMAGE_REGISTRY=ghcr.io/omonqulovjasurbek04-hue

POSTGRES_USER=eavto
POSTGRES_PASSWORD=CHANGE_ME_long_random
POSTGRES_DB=eavto

# Public addresses (https only; the API refuses to start otherwise)
# PUBLIC_API_URL is baked into the frontend build; PUBLIC_API_ORIGIN (no /api) is used by the API for image links and by nginx CSP.
PUBLIC_API_URL=https://api.example.uz/api
PUBLIC_API_ORIGIN=https://api.example.uz
CLIENT_URL=https://example.uz

# Secrets: generate with  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_hex_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# strict when site and API share a domain (example.uz + api.example.uz); none only for a different site
REFRESH_COOKIE_SAMESITE=strict
# Random 32+ chars; encrypts TOTP 2FA secrets
TOTP_ENCRYPTION_KEY=

# Behaviour
ENFORCE_ENROLLMENT=true
ORDER_TTL_MINUTES=60

# Payments: leave empty until a real provider is integrated (mock is refused in production)
PAYMENT_PROVIDER=

# Optional: e-mail for password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=E-Avto <no-reply@example.uz>

# Optional: Telegram login bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Private media uploads are OFF by default (videos normally live on an external CDN)
MEDIA_UPLOAD_ENABLED=false
MEDIA_SIGNING_SECRET=
MAX_IMAGE_MB=5

# Storage for uploaded files: local (the "media" volume) or s3 (AWS S3 / Cloudflare R2 / MinIO, PRIVATE bucket)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Antivirus: set CLAMAV_HOST=clamav and start the stack with --profile antivirus. Empty = uploads are not scanned.
CLAMAV_HOST=
CLAMAV_PORT=3310

# REDIS_URL is set by docker-compose (redis service); only override it for an external Redis.

# Error tracking (Sentry or self-hosted GlitchTip). Empty = disabled.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# Prometheus: GET /api/metrics with "Authorization: Bearer <token>". Empty = disabled. 24+ random chars.
METRICS_TOKEN=
