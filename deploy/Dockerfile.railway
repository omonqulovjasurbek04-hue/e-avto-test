# One image for Railway: the built React site + the API that also serves it (WEB_DIST_DIR).
# Used by railway.json. Railway passes service variables as build args (VITE_API_URL below).

# 1. Site
FROM node:22-alpine AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
# https://<public-domain>/api - set as a Railway variable (https://${{RAILWAY_PUBLIC_DOMAIN}}/api).
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

# 2. API. Dev dependencies stay: the pre-deploy step runs the Prisma CLI and tsx (migrations + bootstrap).
FROM node:22-alpine
RUN apk add --no-cache openssl
WORKDIR /app/backend
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --include=dev && npm cache clean --force
COPY backend/prisma ./prisma
RUN npx prisma generate
COPY backend/tsconfig.json ./
COPY backend/src ./src
RUN npm run build
COPY --from=web /web/dist /app/web

ENV NODE_ENV=production \
    WEB_DIST_DIR=/app/web
# Uploads (MEDIA_DIR=storage/private) are written by the "node" user; /app/backend itself belongs to root.
# A Railway volume mounted here is root-owned: then also set RAILWAY_RUN_UID=0 on the service.
RUN mkdir -p /app/backend/storage/private && chown -R node:node /app/backend/storage
USER node
# Railway sets PORT; the API listens on it.
CMD ["node", "dist/server.js"]
