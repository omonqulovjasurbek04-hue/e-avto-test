# Frontend image. Build from the repository root:
#   docker build -f deploy/Dockerfile.web --build-arg VITE_API_URL=https://api.example.uz/api -t eavto-web .
FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
# The build fails unless this is an https URL (see frontend/vite.config.ts).
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:1.27-alpine
# *.template files are rendered with envsubst at start (API_ORIGIN, API_UPSTREAM).
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
