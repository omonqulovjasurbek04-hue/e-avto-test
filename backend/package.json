{
  "name": "e-avto-test-backend",
  "version": "1.0.0",
  "description": "Backend for E-Avto Test - online driving theory learning and testing platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "release": "prisma migrate deploy && tsx prisma/bootstrap.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests prisma",
    "smoke": "node scripts/prod-smoke.mjs",
    "create-superadmin": "tsx src/scripts/createSuperadmin.ts",
    "test": "vitest run",
    "prisma:deploy": "prisma migrate deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "e-avto",
    "driving",
    "test",
    "express",
    "prisma"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@prisma/client": "^5.18.0",
    "@sentry/node": "^11.8.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^10.1.1",
    "sanitize-html": "^2.18.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "express-list-endpoints": "^7.1.1",
    "globals": "^17.13.0",
    "prisma": "^5.18.0",
    "supertest": "^7.3.1",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.71.2",
    "vitest": "^2.1.9"
  }
}
