DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/e_avto_test"
PORT=5000
JWT_SECRET="change_this_long_random_secret"
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"
# Access token lifetime (short); the session is renewed through an httpOnly refresh cookie.
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
# strict works when the site and the API share a registrable domain (example.uz + api.example.uz).
# Use "none" only if the API lives on a different site (then the cookie must stay Secure).
REFRESH_COOKIE_SAMESITE=strict
# Secure cookies also work on http://localhost; set false only for plain-http LAN testing (never in production).
REFRESH_COOKIE_SECURE=true
# Encrypts TOTP 2FA secrets at rest (random 32+ chars). Empty = derived from JWT_SECRET.
TOTP_ENCRYPTION_KEY=""
# Telegram login bot (optional). Token from @BotFather; username without @.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Optional SMTP for password-reset and e-mail verification links (without it nothing is sent; the link is only printed in development)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="E-Avto Test <no-reply@example.com>"

# Payments: only "mock" exists (no Payme/Click integration yet). Leave empty to disable ordering.
# "mock" is refused when NODE_ENV=production.
PAYMENT_PROVIDER=""
PAYMENT_MOCK_SECRET="change_me_long_random_value"
ORDER_TTL_MINUTES=60
# true = course videos/content need an active enrollment (paid). Default false keeps all published lessons open.
# Lessons and tests open only with a purchased course (default). "false" opens everything (demo only).
ENFORCE_ENROLLMENT=true

# Private media (uploads are off by default; videos normally stay on an external CDN)
MEDIA_UPLOAD_ENABLED=false
MEDIA_DIR=storage/private
MEDIA_SIGNING_SECRET=
MEDIA_URL_TTL_SECONDS=300
# Adaptive (HLS) lesson videos: link lifetime (a lesson plays for a long time), and the converter
# used by `npm run media:import -- --lesson <id> --file video.mp4` (ffmpeg + ffprobe must be installed).
MEDIA_HLS_TTL_SECONDS=14400
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
FFMPEG_PRESET="veryfast"
MAX_VIDEO_MB=500
MAX_FILE_MB=20

# Telegram: if set, updates arrive on POST /api/telegram/webhook/<secret> instead of long polling
TELEGRAM_WEBHOOK_SECRET=
# Webhook mode: the public base URL Telegram posts to (the API registers it on start).
# Empty = RENDER_EXTERNAL_URL (set by Render itself), then PUBLIC_API_ORIGIN.
TELEGRAM_WEBHOOK_BASE=
# RENDER_EXTERNAL_URL=   (provided by Render; do not set by hand)

# Seconds the public leaderboard and landing statistics are cached in memory (0 = off)
LEADERBOARD_CACHE_SECONDS=60

# Public https origin of this API, WITHOUT /api (absolute links to uploaded CMS images). Required in production.
PUBLIC_API_ORIGIN=http://localhost:5000
MAX_IMAGE_MB=5

# Storage for uploaded media and CMS images: "local" (MEDIA_DIR) or "s3" (AWS S3, Cloudflare R2, MinIO).
# The bucket must be PRIVATE: files are streamed by the API after its own access check.
STORAGE_DRIVER=local
S3_BUCKET=
# "auto" for Cloudflare R2; e.g. eu-central-1 for AWS
S3_REGION=auto
# R2: https://<account-id>.r2.cloudflarestorage.com   MinIO: http://minio:9000   AWS: leave empty
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO
S3_FORCE_PATH_STYLE=false
# With STORAGE_DRIVER=s3 the browser gets video segments, posters and files straight from the bucket through
# short-lived signed links (the API only checks access). "false" streams them through the API instead.
MEDIA_DIRECT_DELIVERY=true

# Antivirus: clamd TCP address (e.g. the clamav/clamav Docker image on port 3310). Empty = uploads are not scanned.
# When set, a file is stored only after a clean scan; if clamd is unreachable the upload is refused (503).
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=60000

# Shared rate-limit counters for several API instances (redis://host:6379/0). Empty = per-process memory.
# Kept empty here on purpose: a machine-wide REDIS_URL from another project must not leak into development.
REDIS_URL=

# true + no JWT_SECRET: the server creates a random signing secret on first start and keeps it in the database.
JWT_SECRET_FROM_DB=

# One-service hosting (Railway): path to the built site (e.g. ../frontend/dist). Empty = API only.
WEB_DIST_DIR=

# Production only: how many proxies stand in front of the API (for the real client IP in rate limits).
# 1 = host nginx on a VPS (default); 2 = Render (static-site rewrite + load balancer).
TRUST_PROXY_HOPS=1

# Error tracking: Sentry or a self-hosted compatible service (GlitchTip). Empty = disabled.
# No cookies, headers, bodies, query strings or IPs are sent; only the user id.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# GET /api/metrics (Prometheus) with "Authorization: Bearer <token>". Empty = endpoint disabled. 24+ chars.
METRICS_TOKEN=
